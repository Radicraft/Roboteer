[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

3d_physics/layer_1="arena"
3d_physics/layer_2="bot"
3d_physics/layer_3="debris"
3d_physics/layer_4="hazard"
3d_physics/layer_5="ooa"

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/body_pair_contact_cache_enabled=false

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
environment/defaults/default_clear_color=Color(0.16, 0.16, 0.17, 1)
