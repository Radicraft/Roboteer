[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

3d_physics/layer_1="arena"
3d_physics/layer_2="bot"
3d_physics/layer_3="debris"
3d_physics/layer_4="hazard"
3d_physics/layer_5="ooa"

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/body_pair_contact_cache_enabled=false

[rendering]

; Agent G1 owns this section (docs/graphics-bar.md, docs/graphics-render-notes.md).
; The A19 phone runs Forward+ on Metal, which is what buys SSAO, SSR, real volumetric fog
; and physical glow. `rendering_method.mobile` is the iOS/Android override: it is set to
; forward_plus deliberately, and flipping that ONE key back to "mobile" is the first
; performance lever if the device drops below 60 fps. `.web` is left at its default.
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
environment/defaults/default_clear_color=Color(0.16, 0.16, 0.17, 1)
environment/defaults/default_environment="res://render/default_env.tres"
; MSAA 4x is the high tier; GraphicsQuality turns it off and swaps in FXAA below that,
; per viewport, because a SubViewport does not inherit these.
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=0
; Specular anti aliasing. G3's parts carry a strong normal map (measured xy deviation
; 0.25, z minimum 0.54) on metallic 1.0 surfaces, which sparkles with white speckles at
; phone screen footprints. This clamps roughness per pixel from the screen space normal
; derivative; the other half of the fix is roughness-from-normal in the texture imports.
anti_aliasing/screen_space_roughness_limiter/enabled=true
anti_aliasing/screen_space_roughness_limiter/amount=0.4
anti_aliasing/screen_space_roughness_limiter/limit=0.18
; G2 owns this ONE key in G1's section. Godot only builds the ETC2/ASTC variants of a
; VRAM-compressed texture when it is on, and without it every texture in Arena/assets/
; textures falls back to uncompressed on iOS: 74.7 MB of pck and the full uncompressed
; footprint in VRAM. See docs/graphics-textures-notes.md.
textures/vram_compression/import_etc2_astc=true
; 8x anisotropic. NOTE the enum: 0=1x, 1=2x, 2=4x, 3=8x, 4=16x, so this key's "4" would
; be 16x, not 4x. RAISED 2026-09-16 from 2 (4x) to 3 (8x) on a measurement (agent V4,
; docs/wave-v-v4-notes.md): the arena floor is a 2048 plate tiled 4x and seen at a 50
; degree pitch, so the far half of it is sampled at an anisotropy of about 1:6 and 4x taps
; leave it smeared. 8x covers that; 16x buys nothing beyond it at this pitch and costs
; another doubling of the tap count on the largest surface in the frame.
textures/default_filters/anisotropic_filtering_level=3
; Mipmap LOD bias. Measured (docs/wave-v-v4-notes.md): every surface a machine wears is
; MINIFIED at the fight camera (1.4 to 11 texels per screen pixel), so the sampler is
; already reading mip 1 to mip 3 and the grain that makes brushed steel look like metal is
; averaged away before it reaches the screen. A third of a mip of negative bias puts some
; of it back. Anything past about -0.5 starts to shimmer on the floor plate in motion;
; this is the dial to back off FIRST if it does, before anything else in here changes.
textures/default_filters/texture_mipmap_bias=-0.35
; 3D resolution is NATIVE and pinned here so nothing can quietly scale it down: mode 0 is
; bilinear (no FSR) and scale 1.0 is one rendered pixel per viewport pixel. The fight draws
; into its own SubViewport (fight.tscn `Stage`), and GraphicsQuality.apply_subviewport_container()
; is what sizes that in real device pixels; see docs/wave-v-v4-notes.md for the measurement
; that says the canvas_items stretch was costing 15 % of them.
scaling_3d/mode=0
scaling_3d/scale=1.0
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=2048
